#!/usr/bin/env bash
# Opens a markdown file rendered beside this pane in herdr-app (-w: in a
# floating window), from the Mac or any machine herdr-app is connected to.
# The mdview mod watches for this label.
set -euo pipefail

main() {
  local label=mdview.open
  if [[ "${1:-}" == "-w" ]]; then
    label=mdview.window
    shift
  fi
  if [[ $# -ne 1 ]]; then
    echo "usage: mdv [-w] <file.md>   (-w: in a floating window)" >&2
    exit 2
  fi
  if [[ -z "${HC_TERMINAL_ID:-}" ]]; then
    echo "mdv: not in a herdr-app terminal" >&2
    exit 2
  fi
  if [[ ! -f "$1" ]]; then
    echo "mdv: no such file: $1" >&2
    exit 1
  fi
  hc label "$HC_TERMINAL_ID" "$label=$(realpath "$1")" >/dev/null
}

main "$@"
